{
  "name": "avpvh/audio-transcriptie",
  "description": "WordPress client and editor for progressive audio transcription.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/grmt/avpvh-audio-transcriptie",
  "keywords": [
    "audio",
    "speech-to-text",
    "transcription",
    "wordpress",
    "wordpress-plugin"
  ],
  "support": {
    "issues": "https://github.com/grmt/avpvh-audio-transcriptie/issues",
    "source": "https://github.com/grmt/avpvh-audio-transcriptie"
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "wordpress/sqlite-database-integration",
        "version": "3.1.3",
        "type": "library",
        "dist": {
          "type": "zip",
          "url": "https://downloads.wordpress.org/plugin/sqlite-database-integration.3.1.3.zip"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "roots/wordpress-no-content": "^7.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wordpress/sqlite-database-integration": "3.1.3",
    "wp-coding-standards/wpcs": "^3.2",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "check": [
      "@phpcs",
      "@test"
    ],
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "test": "phpunit"
  }
}
